   PSM->SET.FRCE_OFF = PSM_ANY_PROC1;         /* assert reset to core1      */
-  while (PSM->DONE & PSM_ANY_PROC1) {}       /* wait until it powers off   */
+  while ((PSM->FRCE_OFF & PSM_ANY_PROC1) == 0U) {} /* wait for APB write    */
   PSM->CLR.FRCE_OFF = PSM_ANY_PROC1;         /* release — core1 enters ROM */
-
+
+  /* Consume the boot ROM's reset notification before starting the launch
+     handshake. The ROM drains its FIFO and pushes zero after reset. */
+  (void)fifoBlockingRead();
+
   /* Starting core 1.*/
   seq = 0;
   do {
